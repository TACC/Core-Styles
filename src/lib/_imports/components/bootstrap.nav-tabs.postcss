@import url("../tools/x-tabs.postcss");

.nav-tabs,
.tab-pane {
  @mixin tabs--custom-properties;
}

.nav-tabs {
  @mixin tabs;
  border-bottom: none;
}
ul.nav-tabs {
  padding-left: unset; /* overwrite core-styles.cms.css */
  margin-bottom: 0; /* overwrite core-styles.base.css */
}

.tab-pane {
  @mixin tabs__content--structure;
  @mixin tabs__content--skin;
}
.nav-tabs .nav-link {
  @mixin tabs__tab--structure;
  @mixin tabs__tab--skin;

  /* To overwrite Bootstrap _nav.scss border */
  border-top: none;
  border-inline: none;
  border-radius: 0;
}
.nav-tabs .nav-link:hover {
  @mixin tabs__tab--hover;
}

.nav-tabs .nav-link.active {
  @mixin tabs__tab--active;
}
.nav-tabs .nav-link:not(.active) {
  @mixin tabs__tab--not-active;
}
