<dl>
  <dt><code>button</code></dt>
  <dd>
    <button class="x-button">&lt;button&gt;</button>
    <a href="#" class="x-button">&lt;a&gt;</a>
  </dd>

  <dt><code>button--primary</code></dt>
  <dd>
    <button class="x-button x-button--type-primary">default</button>
    <button class="x-button x-button--type-primary" disabled>disabled</button>
    <button class="x-button x-button--type-primary x-button--is-busy" disabled>--is-busy</button>
    <a href="#" class="x-button x-button--type-primary">default</a>
    <a href="#" class="x-button x-button--type-primary" disabled tabindex="-1">disabled</a>
  </dd>

  <dt><code>button--secondary</code></dt>
  <dd>
    <button class="x-button x-button--type-secondary">default</button>
    <button class="x-button x-button--type-secondary" disabled>disabled</button>
    <button class="x-button x-button--type-secondary x-button--is-busy" disabled>--is-busy</button>
    <a href="#" class="x-button x-button--type-secondary">default</a>
    <a href="#" class="x-button x-button--type-secondary" disabled tabindex="-1">disabled</a>
  </dd>

  <dt><code>button--tertiary</code></dt>
  <dd>
    <button class="x-button x-button--type-tertiary">default</button>
    <button class="x-button x-button--type-tertiary" disabled>disabled</button>
    <button class="x-button x-button--type-tertiary x-button--is-busy" disabled>--is-busy</button>
    <a href="#" class="x-button x-button--type-tertiary">default</a>
    <a href="#" class="x-button x-button--type-tertiary" disabled tabindex="-1">disabled</a>
  </dd>

  <dt><code>button--is-active</code></dt>
  <dd>
    <button class="x-button x-button--is-active">default</button>
    <button class="x-button x-button--is-active" disabled>disabled</button>
    <button class="x-button x-button--is-active x-button--is-busy" disabled>--is-busy</button>
  </dd>

  <dt><code>button--as-link</code></dt>
  <dd>
    <button class="x-button x-button--as-link">default</button>
    <button class="x-button x-button--as-link x-button--as-link--hover">:hover</button>
    <button class="x-button x-button--as-link x-button--as-link--active">:active</button>
    <a href="#" class="x-button x-button--as-link">default</a>
  </dd>

  <dt><code>button--size-…</code></dt>
  <dd>
    <button class="x-button x-button--type-secondary x-button--size-small">small &lt;button&gt;</button>
    <a href="#" class="x-button x-button--type-secondary x-button--size-small">small &lt;a&gt;</a>
  </dd>

  <dt><code>button--width-…</code></dt>
  <dd>
    <button class="x-button x-button--type-secondary x-button--width-short">short &lt;button&gt;</button>
    <button class="x-button x-button--type-secondary x-button--width-medium">medium &lt;button&gt;</button>
    <button class="x-button x-button--type-secondary x-button--width-long">long &lt;button&gt;</button>
  </dd>
  <dd>
    <a href="#" class="x-button x-button--type-secondary x-button--width-short">short &lt;a&gt;</a>
    <a href="#" class="x-button x-button--type-secondary x-button--width-medium">medium &lt;a&gt;</a>
    <a href="#" class="x-button x-button--type-secondary x-button--width-long">long &lt;a&gt;</a>
  </dd>
</dl>
