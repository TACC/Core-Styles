{{> @message
    tag="p"
    content="The <code>o-section--has-border</code> feature will be made available for all clients in the future."
}}
<section class="o-section o-section--style-light o-section--has-border">
    <h2>Section (Style Light, Has Border)</h2>
    <p>{{> @text-of-one-paragraph-with-actions }}</p>
</section>
<section class="o-section o-section--style-muted o-section--has-border">
    <h2>Section (Style Muted, Has Border)</h2>
    <p>{{> @text-of-one-paragraph-with-actions }}</p>
</section>
<section class="o-section o-section--style-dark o-section--has-border">
    <h2>Section (Style Dark, Has Border)</h2>
    <p>{{> @text-of-one-paragraph-with-actions }}</p>
</section>
<section class="o-section o-section--style-muted">
    <h2>Section (Style Muted, No Border)</h2>
    <p>{{> @text-of-one-paragraph-with-actions }}</p>
</section>
<section class="o-section o-section--style-muted">
    <h2>Section (Style Muted, No Border)</h2>
    <p>{{> @text-of-one-paragraph-with-actions }}</p>
</section>
<section class="o-section o-section--style-light o-section--has-border">
    <h2>Section (Style Light, Has Border) (with Nested Sections)</h2>
    <p>{{> @text-of-one-paragraph-with-actions }}</p>
    <section class="o-section o-section--style-muted o-section--has-border">
        <h3>(Nested) Section (Style Muted, Has Border)</h3>
        <p>{{> @text-of-one-paragraph-with-actions }}</p>
    </section>
    <section class="o-section o-section--style-muted o-section--has-border">
        <h3>(Nested) Section (Style Muted, Has Border)</h3>
        <p>{{> @text-of-one-paragraph-with-actions }}</p>
    </section>
</section>
