<dl>
  <dt><code>button</code> (raw)</dt>
  <dd>
    <dfn><code>&lt;button&gt;</code>:</dfn>
    {{> @x-button--tag tag="button" label="default" }}
  </dd>
  <dd>
    <dfn><code>&lt;a&gt;</code>:</dfn>
    {{> @x-button--tag tag="a" label="default" }}
  </dd>

