/*
Center

Styles that allow centering for specific contexts.

Caveat: Only generic solutions with limited side effects are supported. See "Reference" section for more solutions.

Reference:
- [Centering in CSS: A Complete Guide](https://css-tricks.com/centering-css-complete-guide/)

center--horz-inline                     - Horz. align any num of inline el's
center--horz-block                      - Horz. align any num of block el's
center--horz-block-multiple-children    - Horz. align multiple block el's
center--vert-inline-multiline--flex     - Vert. align multiple inline el's: Flex Method
center--both--flex                      - Vert. & Horz. align any el's

Styleguide Tools.Mixins.Center
*/

/* Horizontal */

/* Horizontal: Inline */
@define-mixin center--horz-inline {
  text-align: center;
}
.x-center--horz-inline {
  @mixin center--horz-inline;
}

/* Horizontal: Block */
@define-mixin center--horz-block {
  margin: 0 auto;
}
.x-center--horz-block {
  @mixin center--horz-block;
}

/* Horizontal: Block: Multiple Children */
@define-mixin center--horz-block-multiple-children {
  display: flex;
  flex-direction: row;
  justify-content: center;
}
.x-center--horz-block-multiple-children {
  @mixin center--horz-block-multiple-children;
}

/* Vertical */

/* Vertical: Inline: Multiple Lines - via Flexbox */
@define-mixin center--vert-inline-multiline--flex {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.x-center--vert-inline-multiline--flex {
  @mixin center--vert-inline-multiline--flex;
}

/* Both */

/* Both: Any - via Flexbox */
@define-mixin center--both--flex {
  display: flex;
  justify-content: center;
  align-items: center;
}
.x-center--both--flex {
  @mixin center--both--flex;
}
